# Reference production environment (ADR-028).
#
#   cp prod.env.example prod.env      # prod.env is gitignored
#   ./scripts/init_prod_secrets.sh    # writes deploy/secrets/, also gitignored
#   docker compose -f compose.prod.yaml --env-file prod.env up -d
#
# NOTHING SECRET GOES IN THIS FILE. The four credentials the gateway holds are
# mounted as files from deploy/secrets/ — an environment variable is readable by
# `docker inspect`, by anything that can read /proc/<pid>/environ, and by every
# crash reporter that dumps the environment.

# --- Published ports --------------------------------------------------------
# The edge is the ONLY service with a published port. 443/80 in production;
# override to unprivileged ports where the host user cannot bind them.
EDGE_HTTPS_PORT=443
EDGE_HTTP_PORT=80

# --- Upstream ---------------------------------------------------------------
# No default and no mock: compose refuses to render without a real endpoint.
FIREWALL_UPSTREAM_BASE_URL=https://api.openai.com/v1

# --- Trust boundary ---------------------------------------------------------
# The edge's address on the `edge` network, and nothing wider. Everything that
# depends on the peer address — operator identity, the throttling key, the HTTPS
# assertion — is only as good as this being narrow (ADR-023, ADR-025, ADR-026).
FIREWALL_TRUSTED_PROXIES=172.30.10.10/32

# --- Limits -----------------------------------------------------------------
# DEVELOPMENT DEFAULTS, deliberately. None was derived from measured traffic, so
# adopting them unchanged gives a limit that is either far too tight or
# decorative (R-67). Size them from your own p95.
EDGE_RATE_PER_SECOND=5
EDGE_BURST=10
EDGE_CONN_PER_IP=20
EDGE_MAX_BODY=256k
FIREWALL_MAX_CONCURRENT_REQUESTS=64
FIREWALL_CALLER_RATE_LIMIT_PER_MINUTE=0

# --- Audit ------------------------------------------------------------------
# `true` makes an audit-write failure fail the request, and makes an unreachable
# database a readiness failure (ADR-012, ADR-027). Off by default: the security
# decision is unaffected by an audit outage.
FIREWALL_REQUIRE_AUDIT=false

# Audit write path (ADR-029). `queue_drop` moves the write off the request path,
# saving ~10 ms p50. It costs durability on an UNGRACEFUL stop: whatever is
# queued is lost, measured at ~250 records after a burst. A graceful stop loses
# nothing. Set `sync` where a hard kill must not lose records — and note that
# FIREWALL_REQUIRE_AUDIT=true forces `sync` and refuses any other combination.
FIREWALL_AUDIT_WRITE_MODE=queue_drop
# Bounded, always: an unbounded queue in front of a failing database is an OOM
# kill wearing a buffer. When it fills, records are dropped and counted in
# firewall_audit_events_dropped_total — ALERT ON ANY NONZERO VALUE.
FIREWALL_AUDIT_QUEUE_SIZE=1000

# --- Database ---------------------------------------------------------------
POSTGRES_USER=firewall
POSTGRES_DB=firewall

# --- Image ------------------------------------------------------------------
# Pin to a digest or an immutable tag in a real deployment; `dev` is what the
# local build produces.
IMAGE_TAG=dev
