# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
# TLS material is a RUNTIME MOUNT, never a repository file (ADR-026). The
# directory itself is ignored, not just its contents, so `git add deploy/certs`
# cannot succeed by accident.
deploy/certs/
# Production secret material is a RUNTIME MOUNT, never a repository file
# (ADR-028). The directory is ignored, not just its contents, so
# `git add deploy/secrets` cannot succeed by accident.
deploy/secrets/
prod.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Model weights and third-party datasets are downloaded, never committed.
# Leading slash matters: an unanchored `models/` also swallows app/models/,
# which is source code and must be committed.
/models/
eval/datasets/raw/
eval/datasets/cache/

# Evaluation output: reports are committed deliberately, scratch runs are not
eval/reports/scratch/

# Editors / OS
.idea/
.vscode/
.DS_Store

# Third-party benchmark data is fetched, never committed
eval/datasets/raw/

# Fine-tuning checkpoints (Strategy A onward). Weights are never committed;
# reproduce with scripts/finetune_strategy_a.py at the recorded commit + seed.
artifacts/
