# LLM Firewall — environment configuration
#
# Copy to `.env` for local development. NEVER commit `.env`.
# Secrets live here and ONLY here — policy YAML structurally rejects them
# (docs/adr/ADR-011-configuration-model.md).
#
# Precedence, lowest to highest:
#   built-in defaults  <  config/environments/<env>.yaml  <  these variables

# --- Environment -----------------------------------------------------------
# development | testing | production
# `production` refuses FIREWALL_CONTENT_LOGGING=full (downgraded to `hash`).
FIREWALL_ENVIRONMENT=development

# --- Logging ---------------------------------------------------------------
FIREWALL_LOG_LEVEL=INFO
# json | console  (console is human-readable, for local development only)
FIREWALL_LOG_FORMAT=console
# none | hash | full   — see docs/10-security-model.md
#   none: no content-derived data is logged at all (production default)
#   hash: truncated SHA-256 fingerprint + length, for repeat-payload correlation
#   full: content is logged. LOCAL DEBUGGING ONLY. Refused in production.
FIREWALL_CONTENT_LOGGING=none

# --- Upstream LLM ----------------------------------------------------------
# Any OpenAI-compatible endpoint. Default is the bundled mock (Phase 0/1).
FIREWALL_UPSTREAM_BASE_URL=http://localhost:8081/v1
# Secret. Leave empty for the mock upstream.
FIREWALL_UPSTREAM_API_KEY=
FIREWALL_UPSTREAM_CONNECT_TIMEOUT_S=5.0
FIREWALL_UPSTREAM_READ_TIMEOUT_S=60.0
FIREWALL_UPSTREAM_MAX_CONNECTIONS=100

# --- Request limits --------------------------------------------------------
FIREWALL_MAX_REQUEST_BYTES=262144

# --- Detectors -------------------------------------------------------------
FIREWALL_POLICY_FILE=config/policies/default.yaml
FIREWALL_DETECTOR_DEFAULT_TIMEOUT_MS=250
# Bounded thread pool for CPU-bound (ML) detectors. See ADR-002.
FIREWALL_DETECTOR_MAX_THREADS=8

# --- Persistence -----------------------------------------------------------
# Secret (contains a password). Unset disables the audit sink.
# Compose publishes PostgreSQL on host port 5434 — 5432 and 5433 are occupied on the
# reference machine (docs/17-deployment-architecture.md).
FIREWALL_DATABASE_URL=postgresql+asyncpg://firewall:firewall@localhost:5434/firewall
FIREWALL_DATABASE_POOL_SIZE=5
FIREWALL_PERSIST_EVENTS=true
# When true, an audit-write failure fails the request (ADR-012). Off by default.
FIREWALL_REQUIRE_AUDIT=false

# --- Observability ---------------------------------------------------------
FIREWALL_METRICS_ENABLED=true
# Off by default: a security gateway must not ship telemetry to a third party
# out of the box (docs/adr/ADR-008-observability-and-privacy.md).
FIREWALL_TRACING_ENABLED=false

# --- Server ----------------------------------------------------------------
FIREWALL_HOST=0.0.0.0
FIREWALL_PORT=8000
