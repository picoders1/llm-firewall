# LLM Firewall — environment configuration
#
# Copy to `.env` for local development. NEVER commit `.env`.
# Secrets live here and ONLY here — policy YAML structurally rejects them
# (docs/adr/ADR-011-configuration-model.md).
#
# Precedence, lowest to highest:
#   built-in defaults  <  config/environments/<env>.yaml  <  these variables

# --- Environment -----------------------------------------------------------
# development | testing | production
# `production` refuses FIREWALL_CONTENT_LOGGING=full (downgraded to `hash`).
FIREWALL_ENVIRONMENT=development

# --- Logging ---------------------------------------------------------------
FIREWALL_LOG_LEVEL=INFO
# json | console  (console is human-readable, for local development only)
FIREWALL_LOG_FORMAT=console
# none | hash | full   — see docs/10-security-model.md
#   none: no content-derived data is logged at all (production default)
#   hash: truncated SHA-256 fingerprint + length, for repeat-payload correlation
#   full: content is logged. LOCAL DEBUGGING ONLY. Refused in production.
FIREWALL_CONTENT_LOGGING=none

# --- Upstream LLM ----------------------------------------------------------
# Any OpenAI-compatible endpoint. Default is the bundled mock (Phase 0/1).
FIREWALL_UPSTREAM_BASE_URL=http://localhost:8081/v1
# Secret. Leave empty for the mock upstream.
FIREWALL_UPSTREAM_API_KEY=
FIREWALL_UPSTREAM_CONNECT_TIMEOUT_S=5.0
FIREWALL_UPSTREAM_READ_TIMEOUT_S=60.0
FIREWALL_UPSTREAM_MAX_CONNECTIONS=100
# Idle connections kept for reuse. Bounded separately: an unbounded keepalive
# pool holds file descriptors against the provider long after a burst has passed.
FIREWALL_UPSTREAM_MAX_KEEPALIVE_CONNECTIONS=20

# --- Request limits --------------------------------------------------------
FIREWALL_MAX_REQUEST_BYTES=262144

# --- Detectors -------------------------------------------------------------
FIREWALL_POLICY_FILE=config/policies/default.yaml
FIREWALL_DETECTOR_DEFAULT_TIMEOUT_MS=250
# Bounded thread pool for CPU-bound (ML) detectors. See ADR-002.
FIREWALL_DETECTOR_MAX_THREADS=8

# --- Persistence -----------------------------------------------------------
# Secret (contains a password). Unset disables the audit sink.
# Compose publishes PostgreSQL on host port 5434 — 5432 and 5433 are occupied on the
# reference machine (docs/17-deployment-architecture.md).
FIREWALL_DATABASE_URL=postgresql+asyncpg://firewall:firewall@localhost:5434/firewall
FIREWALL_DATABASE_POOL_SIZE=5
FIREWALL_PERSIST_EVENTS=true
# When true, an audit-write failure fails the request (ADR-012). Off by default.
FIREWALL_REQUIRE_AUDIT=false

# --- Audit retention (ADR-030) ---------------------------------------------
# Nothing deletes from the audit store unless this is on, and it is off by
# default because deletion is irreversible: an upgrade must not start removing
# an operator's audit trail because a default moved. `compose.prod.yaml` turns
# it on. Startup warns while it is off.
#
# A sweep runs at startup and then every interval, off the request path, in
# bounded batches. `uv run python scripts/purge_audit.py` shows what it would
# delete without deleting it.
FIREWALL_RETENTION_ENABLED=false
# request_traces, and detector_results with them by cascade. Also the console's
# maximum query window, so retention never removes a row the console could still
# have shown.
FIREWALL_RETENTION_TRACE_DAYS=30
# security_events. Longer on purpose: an investigation usually starts well after
# the event. Must be >= FIREWALL_RETENTION_TRACE_DAYS, refused at startup if not.
FIREWALL_RETENTION_EVENT_DAYS=180
FIREWALL_RETENTION_INTERVAL_S=3600
FIREWALL_RETENTION_BATCH_SIZE=1000
FIREWALL_RETENTION_MAX_ROWS_PER_SWEEP=50000

# --- Operator authentication (ADR-023) -------------------------------------
# Identity is terminated OUTSIDE this process, at a reverse proxy or ingress, and
# arrives as a header. Nothing here stores a password or issues a token.
#
# Unset means "derive from the environment": `proxy` in production, `disabled`
# elsewhere. Setting it to `disabled` in production is refused at startup.
# FIREWALL_CONSOLE_AUTH_MODE=proxy
#
# Comma-separated CIDRs. The peer address of the TCP connection must fall inside
# one of these before ANY identity header is read. X-Forwarded-For is never
# consulted — it is client-supplied and proves nothing. `0.0.0.0/0` is refused.
# FIREWALL_TRUSTED_PROXIES=10.4.0.7/32
#
# Secret. Optional second factor for the boundary itself; matters when the
# trusted CIDR is a whole pod network rather than a single ingress address.
# FIREWALL_PROXY_SHARED_SECRET=
#
# Header names the proxy injects. Defaults follow oauth2-proxy.
# FIREWALL_AUTH_SUBJECT_HEADER=X-Auth-Request-User
# FIREWALL_AUTH_ROLES_HEADER=X-Auth-Request-Groups
#
# Comma-separated groups that grant operator access. Empty (the default) means
# any subject the proxy admitted is an operator — correct when the proxy is
# already restricted to the operations team.
# FIREWALL_OPERATOR_ROLES=
#
# Comma-separated CIDRs allowed to scrape /metrics without an operator identity.
# Empty means /metrics requires an operator once the boundary is enforced.
# FIREWALL_METRICS_NETWORKS=
#
# Same-origin sign-out path published by the proxy. Same-origin only: the console
# never links an operator to an external host.
# FIREWALL_CONSOLE_LOGOUT_PATH=/oauth2/sign_out
#
# Send HSTS. Explicit, never inferred — TLS terminates at the ingress, so this
# process cannot see whether the browser hop was HTTPS, and guessing wrong on
# plain HTTP locks a developer out of their own localhost.
FIREWALL_HTTPS_ENFORCED=false

# --- Caller authentication (ADR-024) ---------------------------------------
# A DIFFERENT boundary from the operator console above. Callers of /v1 are
# applications; operators are people. Never share a credential between them.
#
# Unset means "derive from the environment": api_key in production, disabled
# elsewhere. `disabled` in production is refused at startup — this process holds
# FIREWALL_UPSTREAM_API_KEY, so an open /v1 is an open proxy to a paid model.
# FIREWALL_CALLER_AUTH_MODE=api_key
#
# `<caller_id>:<sha256-hex>` pairs, comma separated. **DIGESTS, NEVER KEYS.**
# Generate with:  uv run python scripts/generate_caller_key.py web-app
# The raw key it prints goes to the calling application and nowhere else.
# FIREWALL_CALLER_API_KEYS=web-app:<sha256>,batch-jobs:<sha256>
#
# Proxy mode only: the ingress asserts X-Firewall-Caller and its peer address
# must fall inside this range. X-Forwarded-For is never consulted.
# FIREWALL_CALLER_TRUSTED_PROXIES=10.4.0.7/32
# FIREWALL_CALLER_PROXY_SHARED_SECRET=
# FIREWALL_CALLER_IDENTITY_HEADER=X-Firewall-Caller
#
# Abuse protection. Both are PER PROCESS: with N replicas the effective ceiling
# is N times these values. 0 disables. Default off, because a limit chosen
# without knowing the traffic is a guess that will page someone.
FIREWALL_CALLER_RATE_LIMIT_PER_MINUTE=0
FIREWALL_CALLER_MAX_CONCURRENT_REQUESTS=0

# --- Secure transport (ADR-026) --------------------------------------------
# TLS terminates at the edge; this process never holds a certificate or a key.
#
# When true, operator and gateway requests are served ONLY if a trusted proxy
# asserts the client's hop was HTTPS (`X-Forwarded-Proto`). An absent assertion
# is treated as insecure, not assumed secure — an ingress that forgets the header
# takes the deployment down rather than quietly serving credentials in the clear.
#
# REQUIRED in production: the process refuses to start without it. Requires
# FIREWALL_TRUSTED_PROXIES, because nothing else can vouch for the transport.
# /health, /ready and /metrics stay reachable over plaintext so a misconfigured
# deployment is diagnosable and an internal scraper keeps working.
FIREWALL_HTTPS_ENFORCED=false

# --- Admission control (ADR-025) -------------------------------------------
# The in-process safety net BEHIND the edge, not instead of it. Volumetric abuse
# is the edge's job — see deploy/docker/edge/ and compose.edge.yaml.
#
# Requests in flight at once, across every route. 0 disables. Over this the
# answer is 503 + Retry-After: the server is at capacity, which is a different
# statement from "you exceeded your quota" (429). /health and /ready are exempt.
FIREWALL_MAX_CONCURRENT_REQUESTS=0
#
# Failed caller authentications per minute per client ADDRESS before that client
# is refused before the credential comparison. 0 disables.
#
# OFF BY DEFAULT DELIBERATELY: addresses are shared, so a legitimate caller
# behind the same NAT or egress gateway as an attacker is refused for the window
# and cannot clear its own count (R-65). Enable where callers have distinct
# addresses; rely on the edge where they do not.
FIREWALL_AUTH_FAILURES_PER_MINUTE=0
#
# Read ONLY when the socket peer is inside FIREWALL_TRUSTED_PROXIES. Deliberately
# a single address header, never X-Forwarded-For: a client that could choose its
# own throttling key would change it every request and never hit a limit.
FIREWALL_CLIENT_IP_HEADER=X-Real-IP

# --- Observability ---------------------------------------------------------
FIREWALL_METRICS_ENABLED=true
# Off by default: a security gateway must not ship telemetry to a third party
# out of the box (docs/adr/ADR-008-observability-and-privacy.md).
FIREWALL_TRACING_ENABLED=false

# --- Server ----------------------------------------------------------------
FIREWALL_HOST=0.0.0.0
FIREWALL_PORT=8000
