# Keep secrets, history and test material out of the build context and image.
.env
.env.*
!.env.example
.git
.github
.venv
venv

tests
docs
# Evaluation artefacts: ship the small finalised reports the dashboard reads
# (~200K of result.json), exclude the ~6.7M of per-sample predictions it never
# opens. Keeps the image slim and keeps per-sample rows out of a runtime image.
eval
!eval/results
eval/results/**/predictions*
eval/results/**/*.csv
eval/results/**/*.svg
eval/datasets
scripts

**/__pycache__
**/*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
coverage.xml
htmlcov

models
*.md
!README.md
.idea
.vscode
.DS_Store
artifacts
