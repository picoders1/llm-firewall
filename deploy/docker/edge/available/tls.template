# TLS listener plus an HTTP redirect (ADR-026). Selected by EDGE_TLS_MODE=on.
#
# The certificate and key are RUNTIME MOUNTS. Nothing in this repository or in
# any image layer contains them; `05-render-edge-config.sh` refuses to start the
# container if they are missing, unreadable, mismatched or expired, so a TLS
# deployment cannot silently degrade to plaintext (§25).

server {
    # Redirect only. It carries no gateway locations at all, so there is no path
    # by which a credential can be served over plaintext by this listener —
    # a redirect that also proxied would be a bypass wearing a 301.
    listen 8080;
    server_name _;
    server_tokens off;

    # Probes stay on HTTP and are NOT redirected. A container health check that
    # follows a redirect to a self-signed certificate fails for a reason that has
    # nothing to do with the application's health (§7, §14).
    location = /health { proxy_pass http://firewall-api:8000; access_log off; }
    location = /ready  { proxy_pass http://firewall-api:8000; }

    # 308, not 302: it preserves the method and body, so a POST to
    # /v1/chat/completions is redirected as a POST rather than silently becoming
    # a GET that 405s.
    location / { return 308 https://$host:${EDGE_TLS_PUBLIC_PORT}$request_uri; }
}

server {
    listen 8443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     ${EDGE_TLS_CERT};
    ssl_certificate_key ${EDGE_TLS_KEY};

    # TLS 1.2 is the floor and 1.3 is preferred. 1.0 and 1.1 are deprecated by
    # RFC 8996 and are simply absent rather than explicitly disabled — an
    # allow-list cannot be defeated by a directive somewhere else re-enabling one.
    ssl_protocols TLSv1.2 TLSv1.3;

    # Deliberately NOT an ssl_ciphers list. The Mozilla "intermediate"
    # recommendation for OpenSSL 3.x is to leave the 1.3 suites alone and take
    # OpenSSL's own 1.2 defaults; a hand-written cipher string is a snapshot of
    # someone's advice on the day it was written and rots silently. What is
    # pinned instead is the protocol floor, which is the property that matters
    # and which is testable with a real handshake (§6, §18).
    ssl_prefer_server_ciphers off;

    ssl_session_cache   shared:edge_tls:10m;
    ssl_session_timeout 1h;
    # Off: tickets without rotation weaken forward secrecy, and nginx has no
    # built-in rotation.
    ssl_session_tickets off;

    client_max_body_size ${EDGE_MAX_BODY};
    client_header_timeout 10s;
    client_body_timeout   15s;
    send_timeout          15s;
    keepalive_timeout     30s;

    server_tokens off;

    # Exactly one HSTS header, sourced from the component that actually observed
    # the TLS connection. The application emits its own when a trusted proxy has
    # told it the hop was HTTPS, so without the hide there are two — harmless per
    # RFC 6797, which says a UA reads the first, but a duplicated security header
    # is a thing someone later "fixes" in the wrong direction.
    #
    # `always` so it is present on error responses too: a 429 served over HTTPS
    # should still pin the browser.
    proxy_hide_header Strict-Transport-Security;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    include /etc/nginx/conf.d/gateway.locations.inc;
}
