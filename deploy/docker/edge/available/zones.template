# Shared limiter state (ADR-025). Rendered into http context ahead of the server
# block; nginx requires a zone to be defined before the directive that uses it,
# which is why this file sorts first.
#
# Keyed by $binary_remote_addr — the connection's own peer, NOT X-Forwarded-For.
# A client that could choose its own key could evade the limit by changing it.
limit_conn_zone  $binary_remote_addr zone=conn_per_ip:10m;
limit_req_zone   $binary_remote_addr zone=gateway_per_ip:10m rate=${EDGE_RATE_PER_SECOND}r/s;

limit_req_log_level  warn;
limit_conn_log_level warn;

# 429, not nginx's default 503. A rate limit is a statement about the client;
# 503 is a statement about the server, and a client's backoff logic reacts
# differently to the two.
limit_req_status  429;
limit_conn_status 429;

map $http_upgrade $connection_upgrade { default upgrade; '' close; }
